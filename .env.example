# Google Cloud BigQuery Configuration
# Option 1: Path to your service account key JSON file
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Option 2: If running on Google Cloud (GCE, Cloud Run, etc.),
# credentials are auto-detected and you only need the project ID
BIGQUERY_PROJECT_ID=quick-cache-466013-v5
BIGQUERY_DATASET=scraping
BIGQUERY_TABLE=scraped_products_sql

# Server
PORT=3000
